CREATE TABLE Position (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    latitude REAL,
    longitude REAL,
    accuracy REAL,
    time INTEGER NOT NULL,
    altitude REAL,
    speed REAL,
    bearing REAL,
    battery INTEGER,
    charging INTEGER
);

enqueue:
INSERT INTO Position(latitude, longitude, accuracy, time, altitude, speed, bearing, battery, charging)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

peekMany:
SELECT latitude, longitude, accuracy, time, altitude, speed, bearing, battery, charging
FROM Position
ORDER BY id ASC
LIMIT ?;

removeMany:
DELETE FROM Position
WHERE id IN (SELECT id FROM Position ORDER BY id ASC LIMIT ?);

removeFirst:
DELETE FROM Position
WHERE id = (SELECT MIN(id) FROM Position);

count:
SELECT COUNT(*) FROM Position;
